<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme (light) — minimal framework theme, Compose handles the rest. -->
    <style name="Theme.TahlilDoa" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Splash screen theme. -->
    <style name="Theme.TahlilDoa.Splash" parent="Theme.TahlilDoa">
        <item name="android:windowBackground">@color/cream_background</item>
    </style>
</resources>
